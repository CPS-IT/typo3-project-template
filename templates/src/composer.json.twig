{
	"name": "{{ project.package_name }}",
	"description": "Project bundle for the {{ project.name }} TYPO3 {{ packages.typo3_cms }} project",
	"license": "GPL-2.0-or-later",
	"type": "project",
	"authors": [
		{
			"name": "{{ author.name }}",
			"email": "{{ author.email }}"
		}
	],
	"homepage": "{{ project.url }}",
	"require": {
		"helhum/typo3-console": "^9.0",
{% for additional_package in packages.typo3_system_extensions %}
		"{{ additional_package }}": "^{{ packages.typo3_cms }}",
{% endfor %}
		"typo3/cms-adminpanel": "^{{ packages.typo3_cms }}",
		"typo3/cms-backend": "^{{ packages.typo3_cms }}",
		"typo3/cms-belog": "^{{ packages.typo3_cms }}",
		"typo3/cms-beuser": "^{{ packages.typo3_cms }}",
		"typo3/cms-core": "^{{ packages.typo3_cms }}",
		"typo3/cms-dashboard": "^{{ packages.typo3_cms }}",
		"typo3/cms-extbase": "^{{ packages.typo3_cms }}",
		"typo3/cms-extensionmanager": "^{{ packages.typo3_cms }}",
		"typo3/cms-filelist": "^{{ packages.typo3_cms }}",
		"typo3/cms-fluid": "^{{ packages.typo3_cms }}",
		"typo3/cms-fluid-styled-content": "^{{ packages.typo3_cms }}",
		"typo3/cms-form": "^{{ packages.typo3_cms }}",
		"typo3/cms-frontend": "^{{ packages.typo3_cms }}",
		"typo3/cms-impexp": "^{{ packages.typo3_cms }}",
		"typo3/cms-info": "^{{ packages.typo3_cms }}",
		"typo3/cms-install": "^{{ packages.typo3_cms }}",
		"typo3/cms-lowlevel": "^{{ packages.typo3_cms }}",
		"typo3/cms-opendocs": "^{{ packages.typo3_cms }}",
		"typo3/cms-recycler": "^{{ packages.typo3_cms }}",
		"typo3/cms-redirects": "^{{ packages.typo3_cms }}",
		"typo3/cms-reports": "^{{ packages.typo3_cms }}",
		"typo3/cms-rte-ckeditor": "^{{ packages.typo3_cms }}",
		"typo3/cms-scheduler": "^{{ packages.typo3_cms }}",
		"typo3/cms-seo": "^{{ packages.typo3_cms }}",
{% if packages.typo3_cms != "14.3" %}
		"typo3/cms-setup": "^{{ packages.typo3_cms }}",
{% endif %}
		"typo3/cms-tstemplate": "^{{ packages.typo3_cms }}",
		"typo3/cms-viewpage": "^{{ packages.typo3_cms }}"
	},
	"require-dev": {
		"armin/editorconfig-cli": "^2.0",
{% if features.deployer %}
		"deployer/deployer": "^7.0",
{% endif %}
		"ergebnis/composer-normalize": "^2.28",
		"friendsofphp/php-cs-fixer": "^3.57",
		"helmich/typo3-typoscript-lint": "^3.0",
{% if features.phpstan %}
		"phpstan/extension-installer": "^1.2",
{% endif %}
		"roave/security-advisories": "dev-latest",
{% if features.phpstan %}
		"saschaegerer/phpstan-typo3": "{{ features.phpstan }}",
{% endif %}
		"shipmonk/composer-dependency-analyser": "^1.8",
{% if features.rector %}
		"ssch/typo3-rector": "^3.0",
{% endif %}
		"typo3/coding-standards": "^0.8.0",
		"typo3/testing-framework": "^9.0"
	},
	"repositories": [
		{
			"type": "path",
			"url": "./packages/*"
		}
	],
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
{% if features.phpstan %}
			"phpstan/extension-installer": true,
{% endif %}
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"platform": {
			"php": "{{ get_latest_stable_php_version(packages.php) }}"
		},
		"policy": {
			"abandoned": {
				"audit": "report"
			}
		},
		"sort-packages": true
	},
	"scripts": {
		"post-autoload-dump": [
			"typo3 install:fixfolderstructure"
		],
		"check": [
			"@check:deps",
{% if features.rector %}
			"@check:refactor",
{% endif %}
{% if features.phpstan %}
			"@check:static",
{% endif %}
			"@check:style"
		],
		"check:deps": "composer-dependency-analyser",
{% if features.rector %}
		"check:refactor": [
			"@check:refactor:php"
		],
		"check:refactor:php": "@refactor:php --dry-run",
{% endif %}
{% if features.phpstan %}
		"check:static": "phpstan analyse -c build/checks/phpstan.neon --memory-limit=2G $(find packages -mindepth 2 -maxdepth 2 -type d -name 'Classes' -o -name 'Configuration' -o -name 'Tests')",
{% endif %}
		"check:style": [
			"@check:style:composer",
			"@check:style:editorconfig",
			"@check:style:php",
			"@check:style:typoscript"
		],
		"check:style:composer": "@fix:composer --dry-run",
		"check:style:editorconfig": "ec",
		"check:style:php": "@fix:php --dry-run",
		"check:style:typoscript": "typoscript-lint -c build/checks/typoscript-lint.yml --fail-on-warnings",
		"ci": [
			"@composer validate --strict",
			"@composer audit",
			"@check:deps",
{% if features.rector %}
			"@check:refactor",
{% endif %}
{% if features.phpstan %}
			"@check:static --error-format github",
{% endif %}
			"@check:style"
		],
		"fix": [
			"@fix:composer",
			"@fix:editorconfig",
			"@fix:php"
		],
		"fix:composer": "@composer normalize",
		"fix:editorconfig": "@check:style:editorconfig --fix",
		"fix:php": "php-cs-fixer fix --config build/checks/.php-cs-fixer.php",
{% if features.rector %}
		"refactor": [
			"@refactor:php"
		],
		"refactor:php": [
			"Composer\\Config::disableProcessTimeout",
			"rector process -c build/checks/rector.php"
		],
{% endif %}
		"test": "@test:coverage --no-coverage",
		"test:coverage": "phpunit -c build/tests/phpunit.xml"
	},
	"scripts-descriptions": {
		"check": "Run all code quality checks",
		"check:deps": "Check dependency usage",
{% if features.rector %}
		"check:refactor": "Check for possible code refactorings",
		"check:refactor:php": "Check for possible PHP code refactorings with TYPO3 Rector",
{% endif %}
{% if features.phpstan %}
		"check:static": "Check for errors reported by the static code analyzers",
{% endif %}
		"check:style": "Run all code style checks",
		"check:style:composer": "Check code style of `composer.json`",
		"check:style:editorconfig": "Check all project files for compliance with `.editorconfig` rules",
		"check:style:php": "Check code style of PHP files",
		"check:style:typoscript": "Check code style of TypoScript files",
		"ci": "Run all checks in CI",
		"fix": "Fix all code quality issues",
		"fix:composer": "Fix all issues in `composer.json`",
		"fix:editorconfig": "Fix all styling issues violating `.editorconfig` rules",
		"fix:php": "Fix all issues in PHP files",
{% if features.rector %}
		"refactor": "Apply all possible code refactorings",
		"refactor:php": "Apply possible PHP code refactorings with TYPO3 Rector",
{% endif %}
		"test": "Run tests with PHPUnit",
		"test:coverage": "Run tests and collect code coverage"
	}
}
